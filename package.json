{
  "name": "kronos-military-management",
  "version": "1.0.0",
  "description": "Branch-aware Discord and web personnel management for U.S. military Roblox communities.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
